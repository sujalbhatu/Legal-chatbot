# ==============================================
# Legal Query System — Production Environment
# ==============================================
# Copy this file to each service's directory and
# fill in your actual values.
#
# For Node.js backend:  /opt/legal-query/backend/server/.env
# For RAG pipeline:     /opt/legal-query/backend/rag_model/.env
# ==============================================

# --- Node.js Backend (.env) ---
PORT=3001
MONGODB_URI="your-mongodb-atlas-connection-string-here"
JWT_SECRET="generate-a-strong-random-secret-here"
RAG_API_URL=http://127.0.0.1:5000
NODE_ENV=production

# --- RAG Pipeline (.env) ---
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2
