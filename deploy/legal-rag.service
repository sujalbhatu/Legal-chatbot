[Unit]
Description=Legal Query System - RAG Pipeline (Flask/Gunicorn)
Documentation=https://github.com/SUJALKR18/Legal_Query_System
After=network.target

[Service]
Type=simple
User=legal
Group=legal
WorkingDirectory=/opt/legal-query/backend/rag_model
Environment=PYTHONUNBUFFERED=1

# Use the virtual environment's gunicorn
ExecStart=/opt/legal-query/backend/rag_model/venv/bin/gunicorn -c /opt/legal-query/deploy/gunicorn.conf.py app:app

Restart=always
RestartSec=10

# Memory: embedder + reranker + ChromaDB + BM25 for 123 Acts is estimated at 500-550 MB.
# Above MemoryHigh the kernel reclaims and swaps this service's colder pages first;
# MemoryMax is the hard stop. The models are used on every query, so if `free -m`
# shows the service swapping during normal use, set RETRIEVAL_MODE=hybrid (no reranker).
MemoryHigh=650M
MemoryMax=800M
MemorySwapMax=1G

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/legal-query
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=legal-rag

# Give extra time for model loading on first start
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
